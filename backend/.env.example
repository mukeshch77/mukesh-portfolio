# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

PORT=5000

# Comma-separated list of allowed frontend URLs.
# Local dev:  http://localhost:5173
# After deploying to Vercel, ADD your Vercel URL here too:
# FRONTEND_URL=https://mukeshchoudhary.vercel.app,https://mukeshchoudhary.dev
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — use a Gmail App Password, NOT your normal password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your16charapppassword

# Email address that receives contact form submissions.
CONTACT_RECEIVER_EMAIL=your-gmail@gmail.com

NODE_ENV=production
